// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * Enum Types
 */

enum Material_Sources {
  theory
  practicum
}

enum Material_Types {
  excersice
  material
  midterm_exam
  final_exam
  responsi
}

enum Report_Status {
  pending
  approved
  rejected
}

enum User_Type {
  student
  lecture
}

/**
 * Table Model
 */

model User {
  id              String    @id @db.Uuid
  sso_email       String    @db.VarChar(155)
  full_name       String    @db.VarChar(155)
  profile_picture String?   @db.VarChar(255)
  gender          String?   @db.VarChar(16)
  born_date       DateTime? @db.Date
  user_type       User_Type
  is_verified     Boolean   @db.Boolean
  created_at      DateTime  @db.Timestamptz()
  updated_at      DateTime  @db.Timestamptz()
  deleted_at      DateTime? @db.Timestamptz()

  student                Student?
  lecture                Lecture?
  owned_external_links   ExternalLink[] @relation("ownedExternalLink")
  created_external_links ExternalLink[] @relation("createdExternalLink")

  @@map("users")
}

model Student {
  user_id       String @id @db.Uuid
  nim           String @db.Char(8)
  year_register Int    @db.SmallInt

  user User @relation(fields: [user_id], references: [id])

  @@map("students")
}

model Lecture {
  user_id      String  @id @db.Uuid
  nip          String? @db.VarChar(20)
  phone_number String? @db.VarChar(25)

  user User @relation(fields: [user_id], references: [id])

  @@map("lectures")
}

model ExternalLink {
  id            String    @id @db.Uuid
  owner         User      @relation(fields: [owner_id], references: [id], name: "ownedExternalLink")
  platform_name String    @db.VarChar(100)
  url_target    String    @db.VarChar(255)
  icon          String    @db.VarChar(255)
  creator       User      @relation(fields: [creator_id], references: [id], name: "createdExternalLink")
  created_at    DateTime  @db.Timestamptz()
  updated_at    DateTime  @db.Timestamptz()
  deleted_at    DateTime? @db.Timestamptz()

  owner_id   String @db.Uuid
  creator_id String @db.Uuid
}
