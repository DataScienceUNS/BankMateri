// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * Enum Types
 */

enum Material_Type {
  theory
  practicum
}

enum Report_Status {
  pending
  approved
  rejected
}

enum User_Type {
  student
  lecture
}

enum Access_Type {
  guest
  verified
  supervisor
  admin
}

/**
 * Table Model
 */

// User Section
model User {
  id              String      @id @default(uuid(7)) @db.Uuid
  sso_email       String      @unique @db.VarChar(155)
  full_name       String      @db.VarChar(155)
  profile_picture String?     @db.VarChar(255)
  gender          String?     @db.VarChar(16)
  born_date       DateTime?   @db.Date
  user_type       User_Type?
  access_type     Access_Type @default(guest)
  created_at      DateTime    @default(now()) @db.Timestamptz()
  updated_at      DateTime    @updatedAt @db.Timestamptz()
  deleted_at      DateTime?   @db.Timestamptz()

  student                  Student?
  lecture                  Lecture?
  owned_external_links     ExternalLink[]   @relation("ownedExternalLink")
  created_external_links   ExternalLink[]   @relation("createdExternalLink")
  sessions                 Session[]
  uploaded_subjects        Subject[]
  created_materials        Material[]
  created_class            SubjectClass[]
  created_material_report  MaterialReport[] @relation("ReportedMaterialReport")
  reviewed_material_report MaterialReport[] @relation("ReviewedMaterialReport")
  bookmarks                Bookmark[]

  @@map("users")
}

model Student {
  user_id       String @id @db.Uuid
  nim           String @db.Char(8)
  year_register Int    @db.SmallInt

  user           User                 @relation(fields: [user_id], references: [id])
  class_assisted PracticumAssistant[]
  class_enrolled ClassHistoryTracks[]

  @@map("students")
}

model Lecture {
  user_id      String  @id @db.Uuid
  nip          String? @db.VarChar(20)
  phone_number String? @db.VarChar(25)

  user        User           @relation(fields: [user_id], references: [id])
  teach_class SubjectClass[]

  @@map("lectures")
}

model ExternalLink {
  id            String    @id @default(uuid(7)) @db.Uuid
  owner         User      @relation(fields: [owner_id], references: [id], name: "ownedExternalLink")
  platform_name String    @db.VarChar(100)
  url_target    String    @db.VarChar(255)
  icon          String?   @db.VarChar(255)
  creator       User      @relation(fields: [creator_id], references: [id], name: "createdExternalLink")
  created_at    DateTime  @default(now()) @db.Timestamptz()
  updated_at    DateTime  @updatedAt @db.Timestamptz()
  deleted_at    DateTime? @db.Timestamptz()

  owner_id   String @db.Uuid
  creator_id String @db.Uuid

  @@map("external_links")
}

model Session {
  id              String    @id @default(uuid(7)) @db.Uuid
  user            User      @relation(references: [id], fields: [user_id])
  user_agent      String    @db.VarChar(255)
  os_version      String?   @db.VarChar(115)
  browser_version String?   @db.VarChar(115)
  device_type     String?   @db.VarChar(50)
  ip_address      String    @db.VarChar(45)
  logged_in_at    DateTime  @db.Timestamptz()
  logged_out_at   DateTime? @db.Timestamptz()

  user_id String @db.Uuid

  @@map("sessions")
}

model PracticumAssistant {
  subject_class SubjectClass @relation(fields: [subject_class_id], references: [id])
  assistant     Student      @relation(fields: [student_id], references: [user_id])

  subject_class_id String @db.Uuid
  student_id       String @db.Uuid

  @@id([subject_class_id, student_id])
  @@map("practicum_assistant")
}

model ClassHistoryTracks {
  class      SubjectClass @relation(fields: [class_id], references: [id])
  student    Student      @relation(fields: [student_id], references: [user_id])
  created_at DateTime     @default(now()) @db.Timestamptz()
  ended_at   DateTime     @db.Timestamptz()

  class_id   String @db.Uuid
  student_id String @db.Uuid

  @@id([class_id, student_id])
  @@map("class_history_tracks")
}

// Subject Section
model Subject {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String    @db.VarChar(110)
  code          String    @unique @db.Char(6)
  hex_color     String    @db.Char(6)
  term          Int       @db.SmallInt
  keyword       String?   @db.VarChar(255)
  thumbnail_url String?   @db.VarChar(255)
  uploader      User      @relation(fields: [uploader_id], references: [id])
  created_at    DateTime  @default(now()) @db.Timestamptz()
  updated_at    DateTime  @updatedAt @db.Timestamptz()
  deleted_at    DateTime? @db.Timestamptz()

  uploader_id String         @db.Uuid
  materials   Material[]
  class       SubjectClass[]

  @@map("subjects")
}

model SubjectClass {
  id            String   @id @default(uuid(7)) @db.Uuid
  class_code    String   @db.Char(1)
  subject       Subject  @relation(fields: [subject_id], references: [id])
  instructor    Lecture  @relation(fields: [instructor_id], references: [user_id])
  academic_year String   @db.Char(9)
  creator       User     @relation(fields: [creator_id], references: [id])
  created_at    DateTime @default(now()) @db.Timestamptz()

  subject_id              String               @db.Uuid
  instructor_id           String               @db.Uuid
  creator_id              String               @db.Uuid
  practicum_assistant     PracticumAssistant[]
  listed_on_student_track ClassHistoryTracks[]

  @@unique([class_code, subject_id, academic_year])
  @@map("subject_classes")
}

model Material {
  id             String        @id @default(uuid(7)) @db.Uuid
  subject        Subject       @relation(fields: [subject_id], references: [id])
  title          String        @db.VarChar(155)
  description    String?       @db.Text
  source         String        @db.VarChar(125)
  content_url    String        @db.VarChar(500)
  category       String        @db.VarChar(110)
  material_type  Material_Type
  academic_year  String        @db.Char(9)
  visitor_count  Int           @default(0)
  meeting_number Int?          @db.SmallInt
  is_copied      Boolean       @default(false)
  uploader       User          @relation(fields: [uploader_id], references: [id])
  created_at     DateTime      @default(now()) @db.Timestamptz()
  updated_at     DateTime      @updatedAt @db.Timestamptz()
  deleted_at     DateTime?     @db.Timestamptz()

  subject_id    String           @db.Uuid
  uploader_id   String           @db.Uuid
  report_card   MaterialReport[]
  bookmarked_by Bookmark[]

  @@map("materials")
}

model MaterialReport {
  id          String        @id @default(uuid(7)) @db.Uuid
  material    Material      @relation(fields: [material_id], references: [id])
  reporter    User          @relation(fields: [reporter_id], references: [id], name: "ReportedMaterialReport")
  reviewer    User          @relation(fields: [reviewer_id], references: [id], name: "ReviewedMaterialReport")
  reason      String        @db.VarChar()
  description String        @db.Text
  status      Report_Status
  created_at  DateTime      @default(now()) @db.Timestamptz()

  material_id String @db.Uuid
  reporter_id String @db.Uuid
  reviewer_id String @db.Uuid

  @@map("material_reports")
}

model Bookmark {
  user     User     @relation(fields: [user_id], references: [id])
  material Material @relation(fields: [material_id], references: [id])

  user_id     String @db.Uuid
  material_id String @db.Uuid

  @@id([user_id, material_id])
  @@map("bookmarks")
}
